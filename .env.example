# Every value here is public. The frontend holds no server secret.
# Copy to .env.local for `next dev`. Redeploy after any change on Vercel.

NEXT_PUBLIC_APP_NAME=Zeep
NEXT_PUBLIC_APP_URL=https://zeep-frontend.vercel.app
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
NEXT_PUBLIC_API_BASE_URL_TESTNET=https://api-test.zeep.app
NEXT_PUBLIC_API_BASE_URL_MAINNET=https://api.zeep.app
NEXT_PUBLIC_ONION_API_URL_TESTNET=
NEXT_PUBLIC_ONION_API_URL_MAINNET=
NEXT_PUBLIC_ENABLE_FRONTIER_ON_TESTNET=false

NEXT_PUBLIC_SPEND_WASM_URL=/circuits/zeep_spend.wasm
NEXT_PUBLIC_SPEND_WASM_SHA256=7ae27bcdcce4d4f85ef521d6a56bc22e581806ca9ca623d2df3b7155393cbfba
NEXT_PUBLIC_SPEND_ZKEY_URL=/circuits/zeep_spend.zkey
NEXT_PUBLIC_SPEND_ZKEY_SHA256=0ee27fd3e4e5b3ac609ae4f382fa02ee7ba7a9b0b9fb2411096b23705da4b98f

NEXT_PUBLIC_LIGHTWALLETD_URL_TESTNET=
NEXT_PUBLIC_LIGHTWALLETD_URL_MAINNET=
NEXT_PUBLIC_AUTOSHIELD_MIN_ZATS=100000

NEXT_PUBLIC_PIN_LENGTH=6
NEXT_PUBLIC_PIN_MAX_ATTEMPTS=5
NEXT_PUBLIC_ARGON2_MEMORY_KIB=65536
NEXT_PUBLIC_ARGON2_PASSES=3
NEXT_PUBLIC_AUTOLOCK_SEC=300
NEXT_PUBLIC_PASSKEY_RP_ID=zeep-frontend.vercel.app
NEXT_PUBLIC_RECOVERY_WORDS=24
NEXT_PUBLIC_CLIPBOARD_CLEAR_SEC=30
NEXT_PUBLIC_MAX_UPLOAD_MB=20
NEXT_PUBLIC_CHAT_AUTODELETE_DEFAULT=false
NEXT_PUBLIC_CHAT_SYNC_DEFAULT=false

# auto (pick a tier per device) | lite (2D canvas at most) | off (static poster).
# Replaces NEXT_PUBLIC_LANDING_ANIMATION, which still works: false means off.
NEXT_PUBLIC_FX_LEVEL=auto
NEXT_PUBLIC_SOURCE_URL=https://github.com/zeep/zeep
NEXT_PUBLIC_DOCS_URL=https://zeep.app/docs
